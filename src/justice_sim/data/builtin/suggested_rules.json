  "rules": [
    {
      "id": "timmy_ice_cream_prefer_approve",
      "offer_ids": [
        "little_timmy_musical_theme_plays_ooh_ohh_teh_ice_cwea_6f685625",
        "little_timmy_musical_theme_plays_ooh_ohh_teh_ice_cwea_52004749",
        "little_timmy_musical_theme_plays_ooh_ohh_teh_ice_cwea_a9700eed",
        "little_timmy_musical_theme_plays_nonono_i_cant_eat_mo_05a5a624"
      ],
      "biases": [
        {
          "action": "approve",
          "amount": 5,
          "when": "mh > 1"
        }
      ],
      "notes": "Prefer approve unless in imminent danger (low health)."
    },
    {
      "id": "reanimated_hand_bail_me_out_prefer_reject",
      "offer_ids": [
        "reanimated_hand_good_going_judge_your_stupid_laws_just_g_7165cf9b"
      ],
      "biases": [
        {
          "action": "reject",
          "amount": 5,
          "when": "coins < 3 * case_scale"
        }
      ],
      "notes": "Prefer reject unless very far ahead of the curve in coins."
    },
    {
      "id": "reanimated_hand_waive_fine_prefer_approve",
      "offer_ids": [
        "reanimated_hand_i_got_fined_x_coins_by_your_laws_for_usi_aef10241"
      ],
      "biases": [
        {
          "action": "approve",
          "amount": 5,
          "when": "coins >= 2 * case_scale"
        },
        {
          "action": "approve",
          "amount": -5,
          "when": "coins < 2 * case_scale"
        }
      ],
      "notes": "Prefer accept unless low on coins."
    },
    {
      "id": "reanimated_hand_chest_heist_approve",
      "offer_ids": [
        "reanimated_hand_you_look_richer_than_the_guy_i_just_stol_b9c031da"
      ],
      "constraints": [
        {
          "action": "approve",
          "mode": "require",
          "when": "mh <= 2"
        }
      ],
      "notes": "Require the Popularity-for-chest trade only at low Mental Health, where paired simulations found its safety value. At 3+ Mental Health, leave the chest-versus-Popularity choice to planner rollouts."
    },
    {
      "id": "head_honcho_hedgefund_timing",
      "offer_ids": [
        "head_honcho_of_big_biz_llc_good_afternoon_i_am_seeking_invesetment__482cacba"
      ],
      "biases": [
        {
          "action": "approve",
          "amount": -5,
          "when": "case_index >= 10 and case_index <= 15"
        }
      ],
      "constraints": [
        {
          "action": "approve",
          "mode": "forbid",
          "when": "case_index >= 16"
        }
      ],
      "notes": "Avoid approving later in a run; strongest avoid after case 15."
    },
